# --- Application ---
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Database ---
# Rotation: change the password on the Postgres role, update this value, and
# redeploy the API. Requires brief downtime (or a rolling deploy) since
# existing connections using the old password will need to reconnect.
DATABASE_URL=postgres://healthcare:healthcare@localhost:5433/healthcare

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
# Rotation: generate a new value and redeploy. This signs/encrypts active
# sessions, so rotating it invalidates every existing session — all users
# are signed out and must request a fresh OTP. Rotate on suspected
# compromise, or periodically per your org's policy (e.g. annually).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ---
# Leave unset in development: OTP codes are logged to the API console instead
# of being emailed. In production this is required — apps/api/src/email.ts
# refuses to fall back to console logging outside development/test, so a
# missing key fails loudly instead of leaking OTPs/appointment details into
# server logs.
# Rotation: revoke the old key in the Resend dashboard and issue a new one;
# update this value and redeploy. No user-facing impact — this key isn't
# tied to any session or user data.
RESEND_API_KEY=
EMAIL_FROM=Healthcare <gaserojales.dev@gmail.com>

# --- Demo mode ---
# `true` replaces the random sign-in OTP with the fixed code published by
# GET /api/demo (see apps/api/src/routes/demo.ts), so the app can be
# demonstrated without an inbox, and the sign-in page grows a one-click
# account picker. Pair it with `pnpm db:seed:demo`. Refused outright when
# NODE_ENV=production — see apps/api/src/env.ts.
DEMO_MODE=false

# --- Authorization ---
# Comma-separated emails granted the "admin" role on first sign-in. Server-
# assigned only — see apps/api/src/auth.ts's databaseHooks.
ADMIN_EMAILS=

# --- File storage (local disk) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Frontend (Vite, exposed to the browser — no secrets here) ---
VITE_API_URL=http://localhost:3000

# ─────────────────────────── Production (server .env) ───────────────────────
# `bash scripts/deploy.sh up` runs docker-compose.prod.yml: Postgres, the API
# and the web app behind Traefik, published only through a Cloudflare Tunnel.
# See DEPLOY.md. On the server, .env needs ONLY the values below; the compose
# file sets the rest:
#   - NODE_ENV, PORT, UPLOAD_DIR: fixed for the containers.
#   - DATABASE_URL: built from POSTGRES_* and pointed at the postgres service.
#   - BETTER_AUTH_URL, VITE_API_URL: https://<API_DOMAIN>.
#   - WEB_ORIGIN: https://<WEB_DOMAIN>.
#   - DEMO_MODE: never passed; the API refuses it in production anyway.
#
# TUNNEL_TOKEN=          # Zero Trust → Networks → Tunnels → your tunnel → token
# API_DOMAIN=api.example.com      # hostnames only, no https:// — Traefik Host() rules
# WEB_DOMAIN=app.example.com      # route both to http://traefik:80 in the tunnel
#
# POSTGRES_USER=healthcare
# POSTGRES_PASSWORD=     # openssl rand -hex 24 — goes into a URL, so no / + @ :
# POSTGRES_DB=healthcare
#
# BETTER_AUTH_SECRET=    # openssl rand -base64 32
# RESEND_API_KEY=        # required in production
# EMAIL_FROM=Medicore <noreply@example.com>   # domain must be verified in Resend
# ADMIN_EMAILS=you@example.com
# DOCTOR_EMAILS=
# NURSE_EMAILS=
# MAX_UPLOAD_SIZE_MB=5
