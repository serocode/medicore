# --- Application ---
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Database ---
# Rotation: change the password on the Postgres role, update this value, and
# redeploy the API. Requires brief downtime (or a rolling deploy) since
# existing connections using the old password will need to reconnect.
DATABASE_URL=postgres://healthcare:healthcare@localhost:5433/healthcare

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
# Rotation: generate a new value and redeploy. This signs/encrypts active
# sessions, so rotating it invalidates every existing session — all users
# are signed out and must request a fresh OTP. Rotate on suspected
# compromise, or periodically per your org's policy (e.g. annually).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ---
# Leave unset in development: OTP codes are logged to the API console instead
# of being emailed. In production this is required — apps/api/src/email.ts
# refuses to fall back to console logging outside development/test, so a
# missing key fails loudly instead of leaking OTPs/appointment details into
# server logs.
# Rotation: revoke the old key in the Resend dashboard and issue a new one;
# update this value and redeploy. No user-facing impact — this key isn't
# tied to any session or user data.
RESEND_API_KEY=
EMAIL_FROM=Healthcare <gaserojales.dev@gmail.com>

# --- Authorization ---
# Comma-separated emails granted the "admin" role on first sign-in. Server-
# assigned only — see apps/api/src/auth.ts's databaseHooks.
ADMIN_EMAILS=

# --- File storage (local disk) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Frontend (Vite, exposed to the browser — no secrets here) ---
VITE_API_URL=http://localhost:3000
